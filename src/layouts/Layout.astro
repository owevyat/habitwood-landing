---
export interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#050505" />
    <meta
      name="description"
      content="Трекер привычек с дневником, виджетом и визуальной мотивацией. Растите дерево, меняя жизнь."
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />

    <div id="sticky-cta" class="sticky-cta" aria-hidden="true">
      <a
        href="https://www.rustore.ru/catalog/app/com.owevyat.habitwood"
        class="sticky-btn"
        target="_blank"
        rel="noopener"
      >
        Скачать бесплатно
      </a>
    </div>
  </body>
</html>

<style is:global>
  /* ═══════════════════════════════════════════
     ТОКЕНЫ
     ═══════════════════════════════════════════ */
  :root {
    --bg: #050505;
    --surface: #0C0C0C;
    --surface-2: #121212;
    --surface-3: #181818;
    --text: #F2F2F2;
    --text-muted: #8C8C8C;
    --text-dim: #5A5A5A;
    --accent: #8AE66A;
    --accent-soft: rgba(138, 230, 106, 0.14);
    --accent-dark: #081006;
    --gold: #FFD966;
    --border: rgba(255, 255, 255, 0.07);
    --border-strong: rgba(255, 255, 255, 0.13);
    --font-sans: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --radius-sm: 14px;
    --radius: 20px;
    --radius-lg: 28px;
    --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
    --ease-in-out: cubic-bezier(0.65, 0, 0.35, 1);
  }

  /* ═══════════════════════════════════════════
     СБРОС + ОПТИМИЗАЦИЯ
     ═══════════════════════════════════════════ */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  * {
    margin: 0;
    padding: 0;
    min-width: 0;
  }

  html {
    scroll-behavior: smooth;
    -webkit-text-size-adjust: 100%;
  }

  html,
  body {
    overflow-x: hidden;
    max-width: 100vw;
  }

  body {
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--font-sans);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    padding-left: env(safe-area-inset-left);
    padding-right: env(safe-area-inset-right);
    padding-bottom: calc(76px + env(safe-area-inset-bottom));
    /* Оптимизация: не пересчитывать text-rendering */
    text-rendering: optimizeSpeed;
  }

  a {
    color: inherit;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  img,
  svg {
    display: block;
    max-width: 100%;
    height: auto;
  }

  button {
    font: inherit;
    cursor: pointer;
    border: none;
    background: none;
    color: inherit;
  }

  /* ═══════════════════════════════════════════
     СЕКЦИИ — компактные отступы
     ═══════════════════════════════════════════ */
  .section {
    padding: 3.5rem 1.25rem;
    max-width: 1120px;
    margin: 0 auto;
    width: 100%;
    /* Оптимизация: изоляция layout/paint */
    contain: layout style;
  }

  .section-header {
    text-align: center;
    margin-bottom: 2rem;
    max-width: 640px;
    margin-left: auto;
    margin-right: auto;
  }

  .eyebrow {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }

  .section-title {
    font-size: clamp(1.7rem, 6vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .section-subtitle {
    font-size: clamp(0.95rem, 3.6vw, 1.0625rem);
    color: var(--text-muted);
    margin-top: 0.75rem;
    line-height: 1.55;
  }

  .accent {
    color: var(--accent);
  }

  /* ═══════════════════════════════════════════
     КНОПКИ
     ═══════════════════════════════════════════ */
  .btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 0 1.75rem;
    border-radius: 999px;
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: -0.01em;
    transition: transform 0.15s var(--ease-out),
      box-shadow 0.25s var(--ease-out),
      background-color 0.2s var(--ease-out);
    touch-action: manipulation;
    white-space: nowrap;
    /* Оптимизация */
    will-change: transform;
    transform: translateZ(0);
  }

  .btn:active {
    transform: scale(0.97);
  }

  .btn-primary {
    background-color: var(--accent);
    color: var(--accent-dark);
    box-shadow: 0 8px 24px -10px rgba(138, 230, 106, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.18);
  }

  .btn-primary:hover {
    box-shadow: 0 14px 36px -12px rgba(138, 230, 106, 0.5),
      inset 0 1px 0 rgba(255, 255, 255, 0.2);
  }

  .btn-secondary {
    background-color: transparent;
    color: var(--text);
    border: 1px solid var(--border-strong);
  }

  .btn-secondary:hover {
    background-color: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.22);
  }

  /* ═══════════════════════════════════════════
     STICKY CTA
     ═══════════════════════════════════════════ */
  .sticky-cta {
    position: fixed;
    bottom: calc(1rem + env(safe-area-inset-bottom));
    left: 50%;
    width: calc(100% - 2rem);
    max-width: 380px;
    z-index: 100;
    transform: translate3d(-50%, calc(100% + 3rem), 0);
    transition: transform 0.4s var(--ease-out);
    pointer-events: none;
    will-change: transform;
  }

  .sticky-cta.is-visible {
    transform: translate3d(-50%, 0, 0);
    pointer-events: auto;
  }

  .sticky-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 52px;
    padding: 0 1.5rem;
    border-radius: 999px;
    font-weight: 700;
    font-size: 1rem;
    background-color: var(--accent);
    color: var(--accent-dark);
    box-shadow: 0 12px 40px -10px rgba(138, 230, 106, 0.5),
      0 0 0 1px rgba(138, 230, 106, 0.12);
    transition: transform 0.15s var(--ease-out);
  }

  .sticky-btn:active {
    transform: scale(0.97);
  }

  @media (min-width: 900px) {
    .sticky-cta {
      display: none;
    }
    body {
      padding-bottom: 0;
    }
  }

  /* ═══════════════════════════════════════════
     REVEAL
     ═══════════════════════════════════════════ */
  .reveal {
    opacity: 0;
    transform: translate3d(0, 24px, 0);
    transition: opacity 0.7s var(--ease-out), transform 0.7s var(--ease-out);
    will-change: transform, opacity;
  }

  .reveal.is-visible {
    opacity: 1;
    transform: translate3d(0, 0, 0);
    will-change: auto;
  }

  .reveal-d1 { transition-delay: 0.07s; }
  .reveal-d2 { transition-delay: 0.14s; }
  .reveal-d3 { transition-delay: 0.21s; }

  /* ═══════════════════════════════════════════
     ДОСТУПНОСТЬ
     ═══════════════════════════════════════════ */
  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
    #canopy,
    .tree-glow,
    .fog,
    .particle,
    .hero-word {
      animation: none !important;
    }
    html {
      scroll-behavior: auto;
    }
  }

  /* ═══════════════════════════════════════════
     ФОНОВЫЕ СЛОИ (оптимизированы — без blur)
     ═══════════════════════════════════════════ */
  .bg-noise {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    opacity: 0.02;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-size: 180px 180px;
    /* Оптимизация */
    transform: translateZ(0);
  }

  .bg-grid {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    opacity: 0.025;
    background-image: linear-gradient(rgba(255, 255, 255, 0.4) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.4) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse at 50% 0%, black 0%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse at 50% 0%, black 0%, transparent 70%);
    transform: translateZ(0);
  }
</style>