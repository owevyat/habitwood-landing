---
export interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0A0A0A" />
    <meta
      name="description"
      content="Трекер привычек с дневником, виджетом и визуальной мотивацией. Растите дерево, меняя жизнь."
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />

    <div id="sticky-cta" class="sticky-cta" aria-hidden="true">
      <a
        href="https://www.rustore.ru/catalog/app/com.owevyat.habitwood"
        class="sticky-btn"
        target="_blank"
        rel="noopener"
      >
        Скачать бесплатно
      </a>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --bg: #070707;
    --surface: #101010;
    --surface-2: #161616;
    --text: #F2F2F2;
    --text-muted: #8A8A8A;
    --text-dim: #5C5C5C;
    --accent: #8AE66A;
    --accent-glow: rgba(138, 230, 106, 0.18);
    --accent-dark: #0A1408;
    --gold: #FFD966;
    --border: rgba(255, 255, 255, 0.08);
    --border-strong: rgba(255, 255, 255, 0.14);
    --font-sans: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --radius: 22px;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  * {
    margin: 0;
    padding: 0;
    min-width: 0;
  }

  html {
    scroll-behavior: smooth;
    -webkit-text-size-adjust: 100%;
  }

  html,
  body {
    overflow-x: hidden;
    max-width: 100vw;
  }

  body {
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--font-sans);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    padding-left: env(safe-area-inset-left);
    padding-right: env(safe-area-inset-right);
    padding-bottom: env(safe-area-inset-bottom);
  }

  a {
    color: inherit;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  img,
  svg {
    display: block;
    max-width: 100%;
    height: auto;
  }

  button {
    font: inherit;
    cursor: pointer;
    border: none;
    background: none;
    color: inherit;
  }

  /* ═══ Утилиты ═══ */
  .section {
    padding: 4rem 1.25rem;
    max-width: 1100px;
    margin: 0 auto;
    width: 100%;
  }

  .section-header {
    text-align: center;
    margin-bottom: 2.5rem;
    max-width: 640px;
    margin-left: auto;
    margin-right: auto;
  }

  .eyebrow {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.85rem;
  }

  .section-title {
    font-size: clamp(1.75rem, 6.5vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.12;
  }

  .section-subtitle {
    font-size: clamp(0.95rem, 3.6vw, 1.0625rem);
    color: var(--text-muted);
    margin-top: 0.85rem;
    line-height: 1.55;
  }

  .accent {
    color: var(--accent);
  }

  /* ═══ Кнопки ═══ */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 54px;
    padding: 0 1.85rem;
    border-radius: 999px;
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: -0.01em;
    transition: transform 0.15s ease, box-shadow 0.2s ease, background-color 0.2s ease;
    touch-action: manipulation;
    white-space: nowrap;
  }

  .btn:active {
    transform: scale(0.97);
  }

  .btn-primary {
    background-color: var(--accent);
    color: var(--accent-dark);
    box-shadow: 0 10px 32px -12px var(--accent-glow), inset 0 1px 0 rgba(255, 255, 255, 0.15);
  }

  .btn-secondary {
    background-color: transparent;
    color: var(--text);
    border: 1px solid var(--border-strong);
  }

  .btn-secondary:hover {
    background-color: rgba(255, 255, 255, 0.04);
  }

  /* ═══ Sticky CTA ═══ */
  .sticky-cta {
    position: fixed;
    bottom: calc(1rem + env(safe-area-inset-bottom));
    left: 50%;
    width: calc(100% - 2rem);
    max-width: 380px;
    z-index: 100;
    transform: translate(-50%, calc(100% + 2rem));
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
  }

  .sticky-cta.is-visible {
    transform: translate(-50%, 0);
    pointer-events: auto;
  }

  .sticky-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 54px;
    padding: 0 1.5rem;
    border-radius: 999px;
    font-weight: 700;
    font-size: 1rem;
    background-color: var(--accent);
    color: var(--accent-dark);
    box-shadow: 0 12px 40px -10px rgba(138, 230, 106, 0.5), 0 0 0 1px rgba(138, 230, 106, 0.15);
    transition: transform 0.15s ease;
  }

  .sticky-btn:active {
    transform: scale(0.97);
  }

  /* ═══ Reveal при скролле ═══ */
  .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
    #canopy {
      animation: none;
    }
    .tree-glow {
      animation: none;
    }
    html {
      scroll-behavior: auto;
    }
  }

  @media (min-width: 900px) {
    .sticky-cta {
      display: none;
    }
  }
</style>