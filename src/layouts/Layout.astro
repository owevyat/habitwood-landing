---
export interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0A0A0A" />
    <meta
      name="description"
      content="Трекер привычек с дневником, виджетом и визуальной мотивацией. Растите дерево, меняя жизнь."
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />

    <!-- Sticky CTA (появляется после скролла) -->
    <div id="sticky-cta" class="sticky-cta" aria-hidden="true">
      <a
        href="https://www.rustore.ru/catalog/app/com.owevyat.habitwood"
        class="btn btn-primary"
        target="_blank"
        rel="noopener"
      >
        Скачать бесплатно
      </a>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --bg: #0A0A0A;
    --surface: #121212;
    --surface-2: #1A1A1A;
    --text: #F5F5F5;
    --text-muted: #888888;
    --accent: #8AE66A;
    --accent-dark: #0A1408;
    --gold: #FFD966;
    --border: #222222;
    --font-sans: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --radius: 20px;
    --header-height: 64px;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: calc(var(--header-height) + 1rem);
  }

  html,
  body {
    overflow-x: hidden;
    max-width: 100vw;
  }

  body {
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--font-sans);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    padding-left: env(safe-area-inset-left);
    padding-right: env(safe-area-inset-right);
    padding-bottom: env(safe-area-inset-bottom);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img,
  svg {
    display: block;
    max-width: 100%;
    height: auto;
  }

  /* ═══ Типографика ═══ */
  .section {
    padding: 4rem 1.25rem;
    max-width: 1100px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .section-eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }

  .section-title {
    font-size: clamp(1.75rem, 7vw, 2.75rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .section-subtitle {
    font-size: clamp(1rem, 4vw, 1.125rem);
    color: var(--text-muted);
    margin-top: 0.75rem;
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
  }

  /* ═══ Кнопки (Touch-friendly) ═══ */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 0 1.75rem;
    border-radius: 50px;
    font-weight: 800;
    font-size: 1rem;
    border: none;
    cursor: pointer;
    transition: transform 0.15s ease, opacity 0.15s ease;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation; /* Убирает задержку тапа 300ms */
  }

  .btn:active {
    transform: scale(0.97);
  }

  .btn-primary {
    background-color: var(--accent);
    color: var(--accent-dark);
    box-shadow: 0 8px 24px -8px rgba(138, 230, 106, 0.4);
  }

  .btn-secondary {
    background-color: transparent;
    color: var(--text);
    border: 1px solid var(--border);
  }

  /* ═══ Sticky CTA ═══ */
  .sticky-cta {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1rem;
    padding-bottom: calc(1rem + env(safe-area-inset-bottom));
    background: rgba(10, 10, 10, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-top: 1px solid var(--border);
    z-index: 100;
    transform: translateY(100%);
    transition: transform 0.3s ease-in-out;
    display: flex;
    justify-content: center;
  }

  .sticky-cta.is-visible {
    transform: translateY(0);
  }

  .sticky-cta .btn {
    width: 100%;
    max-width: 400px;
  }

  /* ═══ Hero ═══ */
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 100svh;
    padding: 3rem 1.25rem 2rem;
    text-align: center;
    gap: 2rem;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 560px;
  }

  .hero-eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1rem;
  }

  .hero-title {
    font-size: clamp(2rem, 9vw, 3.5rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin-bottom: 1rem;
  }

  .hero-subtitle {
    font-size: clamp(1rem, 4vw, 1.125rem);
    color: var(--text-muted);
    margin-bottom: 1.75rem;
    max-width: 440px;
  }

  .hero-cta {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
    max-width: 320px;
  }

  .hero-cta .btn {
    width: 100%;
  }

  .hero-visual {
    width: 100%;
    max-width: 340px;
    display: flex;
    justify-content: center;
  }

  .tree-svg {
    width: 100%;
    height: auto;
  }

  /* ═══ Анимация дерева ═══ */
  #canopy {
    transform-origin: 140px 250px;
    animation: sway 6s ease-in-out infinite;
  }

  @keyframes sway {
    0%,
    100% {
      transform: rotate(0deg);
    }
    50% {
      transform: rotate(0.6deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #canopy {
      animation: none;
    }
  }

  /* ═══ Features ═══ */
  .features-grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .feature-card {
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.75rem;
    text-align: center;
  }

  .feature-icon {
    width: 56px;
    height: 56px;
    border-radius: 16px;
    background-color: var(--surface-2);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.25rem;
    font-size: 1.75rem;
  }

  .feature-title {
    font-size: 1.25rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
  }

  .feature-description {
    font-size: 0.9375rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  /* ═══ How It Works ═══ */
  .steps-grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    counter-reset: step-counter;
  }

  .step-card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.5rem;
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    counter-increment: step-counter;
  }

  .step-card::before {
    content: counter(step-counter);
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: var(--accent);
    color: var(--accent-dark);
    font-weight: 900;
    font-size: 1.125rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .step-content h3 {
    font-size: 1.125rem;
    font-weight: 800;
    margin-bottom: 0.25rem;
  }

  .step-content p {
    font-size: 0.9375rem;
    color: var(--text-muted);
  }

  /* ═══ Final CTA ═══ */
  .final-cta {
    text-align: center;
    padding: 4rem 1.25rem;
    background: linear-gradient(180deg, transparent 0%, rgba(138, 230, 106, 0.05) 100%);
    border-top: 1px solid var(--border);
  }

  .final-cta .btn {
    margin-top: 1.5rem;
  }

  .qr-code {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .qr-code p {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  /* ═══ Footer ═══ */
  .footer {
    padding: 2rem 1.25rem;
    padding-bottom: calc(2rem + env(safe-area-inset-bottom));
    border-top: 1px solid var(--border);
    text-align: center;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .footer a {
    color: var(--text-muted);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* ═══ Планшет и десктоп ═══ */
  @media (min-width: 720px) {
    .hero {
      flex-direction: row;
      justify-content: center;
      align-items: center;
      text-align: left;
      gap: 4rem;
      padding: 4rem 3rem;
    }

    .hero-content {
      align-items: flex-start;
    }

    .hero-cta {
      flex-direction: row;
    }

    .hero-cta .btn {
      width: auto;
    }

    .hero-visual {
      max-width: 420px;
      flex-shrink: 0;
    }

    .features-grid {
      flex-direction: row;
    }

    .feature-card {
      flex: 1;
      text-align: left;
    }

    .feature-icon {
      margin-left: 0;
    }

    .steps-grid {
      flex-direction: row;
    }

    .step-card {
      flex: 1;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .sticky-cta {
      display: none; /* На десктопе липкая кнопка не нужна */
    }

    .qr-code {
      display: none; /* QR-код тоже только для мобильных, но можно показать на десктопе */
    }
  }
</style>