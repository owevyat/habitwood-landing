---
export interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0A0A0A" />
    <meta
      name="description"
      content="Трекер привычек с дневником, виджетом и визуальной мотивацией. Растите дерево, меняя жизнь."
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --bg: #0A0A0A;
    --surface: #111111;
    --text: #F5F5F5;
    --text-muted: #888888;
    --accent: #8AE66A;
    --accent-dark: #0A1408;
    --gold: #FFD966;
    --border: #1F1F1F;
    --font-sans: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --radius: 20px;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html,
  body {
    overflow-x: hidden;
    max-width: 100vw;
  }

  body {
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--font-sans);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    /* Safe-area отступы для iPhone с «челкой» */
    padding-left: env(safe-area-inset-left);
    padding-right: env(safe-area-inset-right);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img,
  svg {
    display: block;
    max-width: 100%;
    height: auto;
  }

  /* ═══ Кнопки — базово под палец (min 48px) ═══ */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 0 1.75rem;
    border-radius: 50px;
    font-weight: 800;
    font-size: 1rem;
    border: none;
    cursor: pointer;
    transition: transform 0.15s ease, opacity 0.15s ease;
    -webkit-tap-highlight-color: transparent;
  }

  .btn:active {
    transform: scale(0.97);
  }

  .btn-primary {
    background-color: var(--accent);
    color: var(--accent-dark);
  }

  .btn-secondary {
    background-color: transparent;
    color: var(--text);
    border: 1px solid var(--border);
  }

  /* ═══ Первый экран (hero) — mobile-first ═══ */
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 100svh; /* svh — корректно работает с адресной строкой на мобилке */
    padding: 3rem 1.25rem 2rem;
    text-align: center;
    gap: 2rem;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 560px;
  }

  .hero-eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1rem;
  }

  .hero-title {
    font-size: clamp(2rem, 9vw, 3.5rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin-bottom: 1rem;
  }

  .hero-subtitle {
    font-size: clamp(1rem, 4vw, 1.125rem);
    color: var(--text-muted);
    margin-bottom: 1.75rem;
    max-width: 440px;
  }

  .hero-cta {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
    max-width: 320px;
  }

  .hero-cta .btn {
    width: 100%;
  }

  .hero-visual {
    width: 100%;
    max-width: 340px;
    display: flex;
    justify-content: center;
  }

  .tree-svg {
    width: 100%;
    height: auto;
  }

  /* ═══ Анимация покачивания кроны ═══ */
  #canopy {
    transform-origin: 140px 250px;
    animation: sway 6s ease-in-out infinite;
  }

  @keyframes sway {
    0%,
    100% {
      transform: rotate(0deg);
    }
    50% {
      transform: rotate(0.6deg);
    }
  }

  /* Уважаем системную настройку «уменьшить движение» */
  @media (prefers-reduced-motion: reduce) {
    #canopy {
      animation: none;
    }
  }

  /* ═══ Планшет и десктоп: разворачиваем в две колонки ═══ */
  @media (min-width: 720px) {
    .hero {
      flex-direction: row;
      justify-content: center;
      align-items: center;
      text-align: left;
      gap: 4rem;
      padding: 4rem 3rem;
    }

    .hero-content {
      align-items: flex-start;
      max-width: 520px;
    }

    .hero-cta {
      flex-direction: row;
      max-width: none;
    }

    .hero-cta .btn {
      width: auto;
    }

    .hero-visual {
      max-width: 420px;
      flex-shrink: 0;
    }
  }
</style>