---
export interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#050505" />
    <meta
      name="description"
      content="Трекер привычек с дневником, виджетом и визуальной мотивацией. Растите дерево, меняя жизнь."
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />

    <!-- Sticky CTA (только мобильные) -->
    <div id="sticky-cta" class="sticky-cta" aria-hidden="true">
      <a
        href="https://www.rustore.ru/catalog/app/com.owevyat.habitwood"
        class="sticky-btn"
        target="_blank"
        rel="noopener"
      >
        Скачать бесплатно
      </a>
    </div>
  </body>
</html>

<style is:global>
  /* ═══════════════════════════════════════════
     ДИЗАЙН-ТОКЕНЫ — премиальный тёмный минимализм
     ═══════════════════════════════════════════ */
  :root {
    --bg: #050505;
    --surface: #0C0C0C;
    --surface-2: #121212;
    --surface-3: #181818;
    --text: #F2F2F2;
    --text-muted: #8C8C8C;
    --text-dim: #5A5A5A;
    --accent: #8AE66A;
    --accent-glow: rgba(138, 230, 106, 0.16);
    --accent-dark: #081006;
    --gold: #FFD966;
    --border: rgba(255, 255, 255, 0.07);
    --border-strong: rgba(255, 255, 255, 0.12);
    --font-sans: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --radius-sm: 14px;
    --radius: 22px;
    --radius-lg: 32px;
    --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
    --ease-in-out: cubic-bezier(0.65, 0, 0.35, 1);
    --header-h: 64px;
  }

  /* ═══════════════════════════════════════════
     СБРОС И БАЗА
     ═══════════════════════════════════════════ */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  * {
    margin: 0;
    padding: 0;
    min-width: 0;
  }

  html {
    scroll-behavior: smooth;
    -webkit-text-size-adjust: 100%;
  }

  html,
  body {
    overflow-x: hidden;
    max-width: 100vw;
  }

  body {
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--font-sans);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    padding-left: env(safe-area-inset-left);
    padding-right: env(safe-area-inset-right);
    /* Запас снизу, чтобы sticky CTA не перекрывал контент */
    padding-bottom: calc(80px + env(safe-area-inset-bottom));
  }

  a {
    color: inherit;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  img,
  svg {
    display: block;
    max-width: 100%;
    height: auto;
  }

  button {
    font: inherit;
    cursor: pointer;
    border: none;
    background: none;
    color: inherit;
  }

  /* ═══════════════════════════════════════════
     ТИПОГРАФИКА И СЕКЦИИ
     ═══════════════════════════════════════════ */
  .section {
    padding: 5rem 1.25rem;
    max-width: 1120px;
    margin: 0 auto;
    width: 100%;
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
    max-width: 640px;
    margin-left: auto;
    margin-right: auto;
  }

  .eyebrow {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1rem;
  }

  .section-title {
    font-size: clamp(1.8rem, 6.5vw, 2.6rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .section-subtitle {
    font-size: clamp(0.95rem, 3.6vw, 1.0625rem);
    color: var(--text-muted);
    margin-top: 1rem;
    line-height: 1.6;
  }

  .accent {
    color: var(--accent);
  }

  /* ═══════════════════════════════════════════
     КНОПКИ
     ═══════════════════════════════════════════ */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 54px;
    padding: 0 1.85rem;
    border-radius: 999px;
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: -0.01em;
    transition: transform 0.15s var(--ease-out),
      box-shadow 0.25s var(--ease-out),
      background-color 0.2s var(--ease-out);
    touch-action: manipulation;
    white-space: nowrap;
  }

  .btn:active {
    transform: scale(0.97);
  }

  .btn-primary {
    background-color: var(--accent);
    color: var(--accent-dark);
    box-shadow: 0 10px 32px -12px var(--accent-glow),
      inset 0 1px 0 rgba(255, 255, 255, 0.18);
  }

  .btn-primary:hover {
    box-shadow: 0 16px 44px -12px rgba(138, 230, 106, 0.35),
      inset 0 1px 0 rgba(255, 255, 255, 0.2);
  }

  .btn-secondary {
    background-color: transparent;
    color: var(--text);
    border: 1px solid var(--border-strong);
  }

  .btn-secondary:hover {
    background-color: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.2);
  }

  /* ═══════════════════════════════════════════
     STICKY CTA — деликатная, с safe-area
     ═══════════════════════════════════════════ */
  .sticky-cta {
    position: fixed;
    bottom: calc(1rem + env(safe-area-inset-bottom));
    left: 50%;
    width: calc(100% - 2rem);
    max-width: 380px;
    z-index: 100;
    transform: translate(-50%, calc(100% + 3rem));
    transition: transform 0.4s var(--ease-out);
    pointer-events: none;
  }

  .sticky-cta.is-visible {
    transform: translate(-50%, 0);
    pointer-events: auto;
  }

  .sticky-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 54px;
    padding: 0 1.5rem;
    border-radius: 999px;
    font-weight: 700;
    font-size: 1rem;
    background-color: var(--accent);
    color: var(--accent-dark);
    box-shadow: 0 12px 40px -10px rgba(138, 230, 106, 0.45),
      0 0 0 1px rgba(138, 230, 106, 0.12);
    transition: transform 0.15s var(--ease-out);
  }

  .sticky-btn:active {
    transform: scale(0.97);
  }

  /* Скрываем sticky на десктопе */
  @media (min-width: 900px) {
    .sticky-cta {
      display: none;
    }
    body {
      padding-bottom: 0;
    }
  }

  /* ═══════════════════════════════════════════
     REVEAL-АНИМАЦИИ (IntersectionObserver)
     ═══════════════════════════════════════════ */
  .reveal {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.8s var(--ease-out), transform 0.8s var(--ease-out);
  }

  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Задержка для каскада карточек */
  .reveal-delay-1 { transition-delay: 0.08s; }
  .reveal-delay-2 { transition-delay: 0.16s; }
  .reveal-delay-3 { transition-delay: 0.24s; }

  /* ═══════════════════════════════════════════
     ДОСТУПНОСТЬ: уменьшение движения
     ═══════════════════════════════════════════ */
  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
    #canopy {
      animation: none;
    }
    .tree-glow {
      animation: none;
    }
    html {
      scroll-behavior: auto;
    }
    .hero-visual {
      animation: none;
    }
  }

  /* ═══════════════════════════════════════════
     ФОНОВЫЕ СЛОИ (глобальные)
     ═══════════════════════════════════════════ */
  .bg-noise {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    opacity: 0.025;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-size: 180px 180px;
  }

  .bg-grid {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    opacity: 0.03;
    background-image: linear-gradient(rgba(255, 255, 255, 0.4) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.4) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse at 50% 0%, black 0%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse at 50% 0%, black 0%, transparent 70%);
  }
</style>