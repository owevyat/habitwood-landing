---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  const sorted = articles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return sorted.map((article, i) => ({
    params: { slug: article.id },
    props: {
      article,
      prev: sorted[i + 1] ?? null,
      next: sorted[i - 1] ?? null,
    },
  }));
}

const { article, prev, next } = Astro.props;
const { Content } = await render(article);

const formatDate = (d: Date) =>
  d.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Layout title={`${article.data.title} – Дерево привычек`}>
  <div class="bg-noise" aria-hidden="true"></div>
  <div class="bg-grid" aria-hidden="true"></div>

  <div class="reading-progress" id="reading-progress" aria-hidden="true"></div>

  <main class="article-page">
    <nav class="breadcrumbs">
      <a href="/habitwood-landing/articles/">Статьи</a>
      <span class="breadcrumb-sep">/</span>
      <span class="breadcrumb-current">{article.data.category}</span>
    </nav>

    <div class="article-layout">
      <!-- ОСНОВНАЯ КОЛОНКА -->
      <div class="article-main">
        <article class="article-content">
          <header class="article-header">
            <div class="article-meta">
              <span class="article-category">{article.data.category}</span>
              <span class="article-dot"></span>
              <time datetime={article.data.pubDate.toISOString()}>{formatDate(article.data.pubDate)}</time>
            </div>
            <h1 class="article-title">{article.data.title}</h1>
            <p class="article-description">{article.data.description}</p>
          </header>

          <div class="prose" id="article-prose">
            <Content />
          </div>
        </article>

        <div class="article-cta">
          <div class="article-cta-inner">
            <h2>Понравилась статья?</h2>
            <p>Скачайте «Дерево привычек» и начните применять советы на практике.</p>
            <a href="https://www.rustore.ru/catalog/app/com.owevyat.habitwood" class="btn btn-primary" target="_blank" rel="noopener">
              Скачать в RuStore
            </a>
          </div>
        </div>

        {(prev || next) && (
          <nav class="article-nav" aria-label="Навигация по статьям">
            {prev ? (
              <a href={`/habitwood-landing/articles/${prev.id}/`} class="nav-card nav-prev">
                <span class="nav-label">← Предыдущая</span>
                <span class="nav-title">{prev.data.title}</span>
              </a>
            ) : (
              <div></div>
            )}
            {next ? (
              <a href={`/habitwood-landing/articles/${next.id}/`} class="nav-card nav-next">
                <span class="nav-label">Следующая →</span>
                <span class="nav-title">{next.data.title}</span>
              </a>
            ) : (
              <div></div>
            )}
          </nav>
        )}

        <a href="/habitwood-landing/articles/" class="back-link">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M13 8H3M7 4l-4 4 4 4" />
          </svg>
          Все статьи
        </a>
      </div>

      <!-- STICKY САЙДБАР (только десктоп) -->
      <aside class="article-sidebar">
        <div class="app-card">
          <div class="app-card-icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
              <ellipse cx="24" cy="42" rx="12" ry="2" fill="#3A2A18" opacity="0.6" />
              <path d="M22 41 L22 26 C22 24 23 23 24 23 C25 23 26 24 26 26 L26 41 Z" fill="#8A6538" />
              <ellipse cx="24" cy="19" rx="12" ry="10" fill="#2E5A2E" />
              <ellipse cx="18" cy="22" rx="7" ry="6" fill="#3E7B3E" />
              <ellipse cx="30" cy="22" rx="7" ry="6" fill="#3E7B3E" />
              <ellipse cx="24" cy="15" rx="8" ry="6" fill="#5ABA48" />
              <circle cx="22" cy="13" r="1.5" fill="#C8FA9A" />
              <circle cx="28" cy="19" r="1.2" fill="#C8FA9A" />
            </svg>
          </div>
          <h3 class="app-card-title">Дерево привычек</h3>
          <p class="app-card-text">Визуальный трекер привычек с дневником и виджетом</p>
          <a href="https://www.rustore.ru/catalog/app/com.owevyat.habitwood" class="btn btn-primary app-card-btn" target="_blank" rel="noopener">
            Скачать
          </a>
          <p class="app-card-note">Бесплатно · Без рекламы</p>
        </div>
      </aside>
    </div>
  </main>

  <script>
    // ═══ ПРОГРЕСС ЧТЕНИЯ ═══
    const progress = document.getElementById('reading-progress');
    const page = document.querySelector('.article-page');

    if (progress && page) {
      const updateProgress = () => {
        const rect = page.getBoundingClientRect();
        const total = page.offsetHeight - window.innerHeight;
        const scrolled = Math.max(0, -rect.top);
        const pct = Math.min(100, Math.max(0, (scrolled / total) * 100));
        progress.style.width = `${pct}%`;
      };

      window.addEventListener('scroll', updateProgress, { passive: true });
      window.addEventListener('resize', updateProgress, { passive: true });
      updateProgress();
    }

    // ═══ IN-ARTICLE CTA (после 2-го h2 и первого абзаца) ═══
    const prose = document.getElementById('article-prose');
    if (prose) {
      const h2s = prose.querySelectorAll('h2');
      if (h2s.length >= 2) {
        const secondH2 = h2s[1];
        let target = secondH2.nextElementSibling;
        while (target && target.tagName !== 'P') {
          target = target.nextElementSibling;
        }
        if (!target) target = secondH2;

        const cta = document.createElement('div');
        cta.className = 'in-article-cta';
        cta.innerHTML = `
          <div class="in-article-cta-content">
            <p class="in-article-cta-title">Попробуйте на практике</p>
            <p class="in-article-cta-text">Приложение «Дерево привычек» превратит эти советы в визуальный прогресс.</p>
          </div>
          <a href="https://www.rustore.ru/catalog/app/com.owevyat.habitwood" class="btn btn-primary in-article-cta-btn" target="_blank" rel="noopener">
            Скачать
          </a>
        `;
        target.parentNode.insertBefore(cta, target.nextSibling);
      }
    }

    // ═══ STICKY CTA на мобилке (после прочтения хедера статьи) ═══
    const stickyCta = document.getElementById('sticky-cta');
    const articleHeader = document.querySelector('.article-header');
    const pageHero = document.querySelector('.hero');

    if (stickyCta && articleHeader && !pageHero) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const visible = !entry.isIntersecting;
            stickyCta.classList.toggle('is-visible', visible);
            stickyCta.setAttribute('aria-hidden', String(!visible));
          });
        },
        { threshold: 0.05 }
      );
      observer.observe(articleHeader);
    }
  </script>

  <style is:global>
    /* ═══ ПРОГРЕСС ЧТЕНИЯ ═══ */
    .reading-progress {
      position: fixed;
      top: 0;
      left: 0;
      height: 2px;
      width: 0%;
      background: linear-gradient(90deg, var(--accent), #5ABA48);
      z-index: 1000;
      box-shadow: 0 0 12px rgba(138, 230, 106, 0.5);
      transition: width 0.1s linear;
    }

    /* ═══ СТРАНИЦА ═══ */
    .article-page {
      max-width: 1100px;
      margin: 0 auto;
      padding: 3rem 1.25rem 5rem;
      position: relative;
      z-index: 1;
    }

    .breadcrumbs {
      font-size: 0.82rem;
      color: var(--text-muted);
      margin-bottom: 2.5rem;
      font-weight: 600;
    }

    .breadcrumbs a {
      color: var(--text-muted);
      transition: color 0.2s;
    }

    .breadcrumbs a:hover {
      color: var(--text);
    }

    .breadcrumb-sep {
      margin: 0 0.5rem;
      opacity: 0.4;
    }

    .breadcrumb-current {
      color: var(--text-dim);
    }

    /* ═══ LAYOUT: ОДНА КОЛОНКА / ДВЕ КОЛОНКИ ═══ */
    .article-layout {
      display: grid;
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .article-main {
      min-width: 0;
    }

    /* ═══ META ═══ */
    .article-meta {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.5rem;
      font-size: 0.8rem;
      color: var(--text-dim);
      font-weight: 600;
      margin-bottom: 1rem;
    }

    .article-category {
      color: var(--accent);
      font-weight: 700;
    }

    .article-dot {
      width: 3px;
      height: 3px;
      border-radius: 50%;
      background: var(--text-dim);
      opacity: 0.6;
    }

    /* ═══ ЗАГОЛОВОК ═══ */
    .article-header {
      margin-bottom: 3rem;
      padding-bottom: 2rem;
      border-bottom: 1px solid var(--border);
    }

    .article-title {
      font-size: clamp(1.9rem, 6vw, 2.8rem);
      font-weight: 800;
      line-height: 1.12;
      letter-spacing: -0.03em;
      margin-bottom: 1rem;
      color: var(--text);
    }

    .article-description {
      font-size: 1.05rem;
      color: var(--text-muted);
      line-height: 1.6;
    }

    /* ═══ PROSE ═══ */
    .prose {
      color: #C8C8C8;
      line-height: 1.75;
      font-size: 1.05rem;
    }

    .prose h2 {
      font-size: 1.6rem;
      font-weight: 800;
      color: var(--text);
      margin-top: 3rem;
      margin-bottom: 1rem;
      letter-spacing: -0.015em;
      line-height: 1.25;
    }

    .prose h3 {
      font-size: 1.25rem;
      font-weight: 800;
      color: var(--text);
      margin-top: 2rem;
      margin-bottom: 0.75rem;
      line-height: 1.3;
    }

    .prose p {
      margin-bottom: 1.35rem;
    }

    .prose ul, .prose ol {
      margin-bottom: 1.35rem;
      padding-left: 1.5rem;
    }

    .prose li {
      margin-bottom: 0.5rem;
    }

    .prose li::marker {
      color: var(--accent);
    }

    .prose a {
      color: var(--accent);
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 3px;
      transition: opacity 0.2s;
    }

    .prose a:hover {
      opacity: 0.8;
    }

    .prose strong {
      color: var(--text);
      font-weight: 700;
    }

    .prose blockquote {
      margin: 2rem 0;
      padding: 1rem 1.5rem;
      border-left: 3px solid var(--accent);
      background: rgba(138, 230, 106, 0.04);
      border-radius: 0 12px 12px 0;
      color: var(--text);
      font-style: italic;
    }

    .prose code {
      background: var(--surface);
      padding: 0.15rem 0.4rem;
      border-radius: 6px;
      font-size: 0.9em;
      color: var(--accent);
    }

    /* ═══ IN-ARTICLE CTA ═══ */
    .in-article-cta {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      padding: 1.5rem;
      margin: 2.5rem 0;
      background:
        radial-gradient(ellipse at 100% 0%, rgba(138, 230, 106, 0.1) 0%, transparent 60%),
        linear-gradient(135deg, rgba(138, 230, 106, 0.06) 0%, rgba(138, 230, 106, 0.02) 100%);
      border: 1px solid rgba(138, 230, 106, 0.22);
      border-radius: var(--radius);
      position: relative;
      overflow: hidden;
    }

    .in-article-cta::before {
      content: "";
      position: absolute;
      top: 0;
      left: 1.5rem;
      right: 1.5rem;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--accent), transparent);
      opacity: 0.35;
    }

    .in-article-cta-content {
      flex: 1;
      min-width: 0;
    }

    .in-article-cta-title {
      font-size: 1rem;
      font-weight: 800;
      color: var(--text);
      margin: 0 0 0.35rem;
      letter-spacing: -0.01em;
      line-height: 1.3;
    }

    .in-article-cta-text {
      font-size: 0.88rem;
      color: var(--text-muted);
      margin: 0;
      line-height: 1.5;
    }

    .in-article-cta .btn-primary {
      color: var(--accent-dark);
      text-decoration: none;
      min-height: 44px;
      padding: 0 1.25rem;
      font-size: 0.88rem;
      white-space: nowrap;
      flex-shrink: 0;
    }

    /* ═══ CTA В КОНЦЕ ═══ */
    .article-cta {
      margin-top: 4rem;
      border-radius: var(--radius);
      background:
        radial-gradient(ellipse at 50% 0%, rgba(138, 230, 106, 0.15) 0%, transparent 60%),
        var(--surface);
      border: 1px solid var(--border-strong);
      padding: 2.5rem 2rem;
      text-align: center;
    }

    .article-cta-inner {
      max-width: 420px;
      margin: 0 auto;
    }

    .article-cta h2 {
      font-size: 1.5rem;
      font-weight: 800;
      color: var(--text);
      margin-bottom: 0.6rem;
      letter-spacing: -0.02em;
    }

    .article-cta p {
      color: var(--text-muted);
      margin-bottom: 1.75rem;
      line-height: 1.55;
    }

    /* ═══ SIDEBAR ═══ */
    .article-sidebar {
      display: none;
    }

    .app-card {
      position: sticky;
      top: 2rem;
      padding: 1.5rem 1.25rem;
      border-radius: var(--radius);
      background:
        radial-gradient(ellipse at 50% 0%, rgba(138, 230, 106, 0.1) 0%, transparent 60%),
        var(--surface);
      border: 1px solid var(--border-strong);
      text-align: center;
    }

    .app-card-icon {
      width: 56px;
      height: 56px;
      margin: 0 auto 0.85rem;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 16px;
      background: rgba(138, 230, 106, 0.08);
    }

    .app-card-icon svg {
      width: 42px;
      height: 42px;
    }

    .app-card-title {
      font-size: 1rem;
      font-weight: 800;
      color: var(--text);
      margin-bottom: 0.4rem;
      letter-spacing: -0.01em;
    }

    .app-card-text {
      font-size: 0.8rem;
      color: var(--text-muted);
      line-height: 1.45;
      margin-bottom: 1rem;
    }

    .app-card-btn {
      width: 100%;
      min-height: 42px;
      padding: 0 1rem;
      font-size: 0.88rem;
    }

    .app-card-note {
      font-size: 0.7rem;
      color: var(--text-dim);
      margin-top: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.02em;
    }

    /* ═══ НАВИГАЦИЯ ═══ */
    .article-nav {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1rem;
      margin-top: 3rem;
    }

    .nav-card {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      padding: 1.5rem;
      border-radius: var(--radius);
      background: var(--surface);
      border: 1px solid var(--border);
      transition: border-color 0.3s, transform 0.3s;
    }

    .nav-card:hover {
      border-color: var(--border-strong);
      transform: translateY(-2px);
    }

    .nav-next {
      text-align: right;
    }

    .nav-label {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--accent);
    }

    .nav-title {
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--text);
      line-height: 1.4;
    }

    /* ═══ BACK ═══ */
    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      margin-top: 2.5rem;
      font-size: 0.88rem;
      color: var(--text-muted);
      font-weight: 600;
      transition: color 0.2s;
    }

    .back-link svg {
      width: 16px;
      height: 16px;
      transition: transform 0.25s var(--ease-out);
    }

    .back-link:hover {
      color: var(--text);
    }

    .back-link:hover svg {
      transform: translateX(-4px);
    }

    /* ═══ ПЛАНШЕТ ═══ */
    @media (min-width: 640px) {
      .article-page {
        padding: 4rem 2rem 6rem;
      }

      .article-nav {
        grid-template-columns: 1fr 1fr;
      }

      .in-article-cta {
        flex-direction: row;
        align-items: center;
        padding: 1.5rem 1.75rem;
      }
    }

    /* ═══ ДЕСКТОП: SIDEBAR ═══ */
    @media (min-width: 1024px) {
      .article-layout {
        grid-template-columns: minmax(0, 720px) 280px;
        justify-content: center;
        gap: 3rem;
      }

      .article-sidebar {
        display: block;
        align-self: start;
      }
    }
  </style>
</Layout>