---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
---

<Layout title={`${article.data.title} – Дерево привычек`}>
  <div class="bg-noise" aria-hidden="true"></div>
  <div class="bg-grid" aria-hidden="true"></div>

  <main class="article-page">
    <nav class="breadcrumbs">
      <a href="/habitwood-landing/articles/">Статьи</a>
      <span class="breadcrumb-sep">/</span>
      <span class="breadcrumb-current">{article.data.title}</span>
    </nav>

    <article class="article-content">
      <header class="article-header">
        <h1 class="article-page-title">{article.data.title}</h1>
        <time datetime={article.data.pubDate.toISOString()} class="article-page-date">
          {article.data.pubDate.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' })}
        </time>
      </header>

      <div class="prose">
        <Content />
      </div>
    </article>

    <div class="article-cta">
      <h2>Понравилась статья?</h2>
      <p>Скачайте «Дерево привычек» и начните применять советы на практике.</p>
      <a href="https://www.rustore.ru/catalog/app/com.owevyat.habitwood" class="btn btn-primary" target="_blank" rel="noopener">
        Скачать в RuStore
      </a>
    </div>
  </main>
</Layout>

<style is:global>
  .article-page {
    max-width: 760px;
    margin: 0 auto;
    padding: 4rem 1.25rem;
  }

  .breadcrumbs {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
  }

  .breadcrumbs a {
    color: var(--text-muted);
    transition: color 0.2s;
  }

  .breadcrumbs a:hover {
    color: var(--text);
  }

  .breadcrumb-sep {
    margin: 0 0.5rem;
    opacity: 0.4;
  }

  .breadcrumb-current {
    color: var(--text-dim);
  }

  .article-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .article-page-title {
    font-size: clamp(2rem, 6vw, 2.8rem);
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 0.75rem;
    color: var(--text);
  }

  .article-page-date {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 600;
  }

  .prose {
    color: var(--text-muted);
    line-height: 1.75;
    font-size: 1.05rem;
  }

  .prose h2 {
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--text);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  .prose h3 {
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--text);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .prose p {
    margin-bottom: 1.25rem;
  }

  .prose ul, .prose ol {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }

  .prose li {
    margin-bottom: 0.5rem;
  }

  .prose a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .prose strong {
    color: var(--text);
    font-weight: 700;
  }

  .article-cta {
    margin-top: 3rem;
    padding: 2rem;
    text-align: center;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .article-cta h2 {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--text);
    margin-bottom: 0.5rem;
  }

  .article-cta p {
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }
</style>