---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Дерево привычек — Трекер, дневник и виджет">
  <div class="bg-noise" aria-hidden="true"></div>
  <div class="bg-grid" aria-hidden="true"></div>

  <main>
    <!-- ═══════════════════════════════════════
         HERO
         ═══════════════════════════════════════ -->
    <section class="hero">
      <div class="hero-inner">
        <div class="hero-content">
          <span class="hero-eyebrow">Трекер привычек</span>

          <h1 class="hero-title">
            <span class="hero-line">
              <span class="hero-word" style="--d: 0.05s">Растите</span>
              <span class="hero-word accent" style="--d: 0.15s">дерево,</span>
            </span>
            <span class="hero-line">
              <span class="hero-word" style="--d: 0.25s">меняя</span>
              <span class="hero-word" style="--d: 0.35s">жизнь</span>
            </span>
          </h1>

          <p class="hero-subtitle">
            Дневник, стрики и виджет на рабочем столе. Визуальная мотивация,
            которая работает лучше сухих графиков.
          </p>

          <div class="hero-cta">
            <a
              href="https://www.rustore.ru/catalog/app/com.owevyat.habitwood"
              class="btn btn-primary"
              target="_blank"
              rel="noopener"
            >
              Скачать в RuStore
            </a>
            <a href="#features" class="btn btn-secondary">Возможности</a>
          </div>
        </div>

        <div class="hero-visual">
          <div class="tree-stage" id="tree-stage">
            <div class="tree-glow" aria-hidden="true"></div>
            <div class="fog fog-1" aria-hidden="true"></div>
            <div class="fog fog-2" aria-hidden="true"></div>

            <div class="tree-frame" id="tree-frame">
              <svg
                class="tree-svg"
                viewBox="0 0 280 360"
                xmlns="http://www.w3.org/2000/svg"
                role="img"
                aria-label="Дерево привычек в стадии цветения"
