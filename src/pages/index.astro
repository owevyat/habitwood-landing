---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Дерево привычек — Трекер привычек, дневник и виджет">
  <main>
    <!-- ═══ HERO ═══ -->
    <section class="hero">
      <div class="hero-content">
        <span class="hero-eyebrow">Трекер привычек</span>
        <h1 class="hero-title">
          Растите дерево,<br />меняя жизнь
        </h1>
        <p class="hero-subtitle">
          Дневник, стрики и виджет на рабочем столе. Визуальная мотивация,
          которая работает лучше сухих графиков.
        </p>
        <div class="hero-cta">
          <a
            href="https://www.rustore.ru/catalog/app/com.owevyat.habitwood"
            class="btn btn-primary"
            target="_blank"
            rel="noopener"
          >
            Скачать в RuStore
          </a>
          <a href="#features" class="btn btn-secondary">Узнать больше</a>
        </div>
      </div>

      <div class="hero-visual">
        <svg
          class="tree-svg"
          viewBox="0 0 280 360"
          xmlns="http://www.w3.org/2000/svg"
          role="img"
          aria-label="Дерево привычек на стадии цветения"
        >
          <!-- ═══ СТАТИЧНАЯ ЧАСТЬ: остров, ствол ═══ -->
          <g id="static-parts">
            <g id="island-shadow">
              <ellipse cx="140" cy="346" rx="42" ry="4" fill="#2A1A10" opacity="0.4" />
            </g>
            <g id="island-roots">
              <path d="M 122 310 Q 118 326 124 340" fill="none" stroke="#4A3420" stroke-width="2.5" stroke-linecap="round" />
              <path d="M 140 312 Q 140 328 143 342" fill="none" stroke="#4A3420" stroke-width="2.5" stroke-linecap="round" />
              <path d="M 158 308 Q 162 324 158 338" fill="none" stroke="#4A3420" stroke-width="2.5" stroke-linecap="round" />
              <path d="M 112 306 Q 108 318 112 330" fill="none" stroke="#5A3E2A" stroke-width="2" stroke-linecap="round" />
              <path d="M 172 304 Q 176 318 170 332" fill="none" stroke="#5A3E2A" stroke-width="2" stroke-linecap="round" />
            </g>
            <g id="island-fragments">
              <ellipse cx="100" cy="348" rx="5" ry="3" fill="#4A3420" opacity="0.85" />
              <ellipse cx="176" cy="344" rx="4" ry="2.5" fill="#4A3420" opacity="0.85" />
              <circle cx="86" cy="340" r="2.5" fill="#4A3420" opacity="0.7" />
              <circle cx="190" cy="336" r="2" fill="#4A3420" opacity="0.7" />
            </g>
            <g id="island-back">
              <path d="M 76 264 C 76 254 106 248 140 248 C 174 248 204 254 204 264 L 204 282 C 200 290 186 296 172 295 L 172 302 C 178 308 176 314 170 316 L 170 320 C 172 324 168 328 160 328 C 154 332 146 330 140 330 C 134 330 126 332 120 328 C 112 328 108 324 110 320 L 110 316 C 104 314 102 308 108 302 L 108 295 C 94 296 80 290 76 282 Z" fill="#3A2A18" />
            </g>
            <g id="island-main">
              <path d="M 100 300 C 100 294 118 290 140 290 C 162 290 180 294 180 300 L 180 310 C 174 314 162 316 152 315 C 146 317 144 316 140 316 C 136 316 134 317 128 315 C 118 316 106 314 100 310 Z" fill="#4A3420" />
              <ellipse cx="140" cy="300" rx="38" ry="3" fill="#5A4538" />
              <path d="M 88 282 C 88 276 112 272 140 272 C 168 272 192 276 192 282 L 192 294 C 186 299 174 302 162 301 C 152 304 146 303 140 303 C 134 303 128 304 118 301 C 106 302 94 299 88 294 Z" fill="#5A3E2A" />
              <ellipse cx="140" cy="282" rx="50" ry="4" fill="#7AAE55" />
              <path d="M 80 266 C 80 260 108 256 140 256 C 172 256 200 260 200 266 L 200 278 C 195 283 182 286 168 285 C 158 288 152 287 146 287 C 142 289 138 289 134 287 C 128 287 122 288 112 285 C 98 286 85 283 80 278 Z" fill="#6A4A32" />
              <ellipse cx="140" cy="267" rx="52" ry="5" fill="#9EDB70" />
            </g>
            <g id="island-front">
              <path d="M 100 284 Q 98 290 101 293 Q 103 289 102 284 Z" fill="#9EDB70" />
              <path d="M 118 287 Q 117 293 119 296 Q 121 292 120 287 Z" fill="#9EDB70" />
              <path d="M 160 287 Q 159 294 161 297 Q 163 292 162 287 Z" fill="#9EDB70" />
              <path d="M 178 285 Q 177 291 179 294 Q 181 290 180 285 Z" fill="#9EDB70" />
              <path d="M 108 297 Q 106 303 108 306 Q 110 302 110 297 Z" fill="#7AAE55" />
              <path d="M 172 297 Q 170 303 172 306 Q 174 301 174 297 Z" fill="#7AAE55" />
            </g>
            <g id="island-details">
              <ellipse cx="170" cy="268" rx="3" ry="1.5" fill="#3A2A1E" />
              <circle cx="105" cy="269" r="1.5" fill="#3A2A1E" />
              <circle cx="130" cy="271" r="1.2" fill="#3A2A1E" />
              <circle cx="155" cy="270" r="1.3" fill="#3A2A1E" />
              <circle cx="115" cy="288" r="1.5" fill="#3A2A1E" />
              <circle cx="165" cy="290" r="1.3" fill="#3A2A1E" />
              <path d="M 128 304 Q 132 308 130 312" fill="none" stroke="#3A2A1E" stroke-width="0.8" stroke-linecap="round" />
              <path d="M 152 303 Q 155 307 153 311" fill="none" stroke="#3A2A1E" stroke-width="0.8" stroke-linecap="round" />
              <ellipse cx="140" cy="271" rx="9" ry="1.5" fill="#4A3420" opacity="0.55" />
            </g>

            <!-- Ствол (Stage 5) -->
            <g id="trunk-shadow">
              <path d="M134 270 C133 250 134 235 136 222 C136 220 137 218 139 217 C141 218 142 220 143 222 C145 235 146 250 145 270 Z" fill="#4A3420" />
            </g>
            <g id="trunk-main">
              <path d="M136 270 C135 250 136 235 138 222 C138 220 139 218 140 217 C141 218 142 220 142 222 C144 235 145 250 144 270 Z" fill="#8A6538" />
            </g>
            <g id="trunk-light">
              <path d="M143 270 C144 250 144 235 143 223 C142.5 221 142 219 141 218 C142 219 142.5 221 143 224 C144 238 144 255 143 270 Z" fill="#B88A58" />
            </g>
            <g id="trunk-lines">
              <path d="M138 262 C137 248 138 232 139 220" fill="none" stroke="#3A2A1E" stroke-width="0.7" stroke-linecap="round" stroke-linejoin="round" opacity="0.6" />
              <path d="M141 266 C141 248 142 232 142 220" fill="none" stroke="#3A2A1E" stroke-width="0.7" stroke-linecap="round" stroke-linejoin="round" opacity="0.6" />
              <path d="M139 254 C138 244 139 232 140 224" fill="none" stroke="#3A2A1E" stroke-width="0.6" stroke-linecap="round" stroke-linejoin="round" opacity="0.5" />
            </g>
            <g id="branches">
              <path d="M137 245 C134 241 132 236 130 230 L132 229 C134 235 136 239 139 243 Z" fill="#8A6538" />
              <path d="M142 240 C146 236 148 232 150 226 L152 227 C150 232 147 236 144 240 Z" fill="#8A6538" />
            </g>
          </g>

          <!-- ═══ КРОНА (Stage 5) — анимируется ═══ -->
          <g id="canopy">
            <g id="canopy-back">
              <ellipse cx="125" cy="175" rx="16" ry="14" fill="#3E7B3E" stroke="#3E7B3E" stroke-width="2" />
              <ellipse cx="155" cy="175" rx="16" ry="14" fill="#3E7B3E" stroke="#3E7B3E" stroke-width="2" />
              <ellipse cx="140" cy="185" rx="18" ry="16" fill="#3E7B3E" stroke="#3E7B3E" stroke-width="2" />
              <ellipse cx="118" cy="200" rx="14" ry="14" fill="#3E7B3E" stroke="#3E7B3E" stroke-width="2" />
              <ellipse cx="162" cy="200" rx="14" ry="14" fill="#3E7B3E" stroke="#3E7B3E" stroke-width="2" />
              <ellipse cx="140" cy="210" rx="16" ry="14" fill="#3E7B3E" stroke="#3E7B3E" stroke-width="2" />
            </g>
            <g id="canopy-main">
              <ellipse cx="128" cy="178" rx="12" ry="10" fill="#5ABA48" stroke="#5ABA48" stroke-width="2" />
              <ellipse cx="152" cy="178" rx="12" ry="10" fill="#5ABA48" stroke="#5ABA48" stroke-width="2" />
              <ellipse cx="140" cy="186" rx="14" ry="11" fill="#5ABA48" stroke="#5ABA48" stroke-width="2" />
              <ellipse cx="122" cy="200" rx="11" ry="11" fill="#5ABA48" stroke="#5ABA48" stroke-width="2" />
              <ellipse cx="158" cy="200" rx="11" ry="11" fill="#5ABA48" stroke="#5ABA48" stroke-width="2" />
              <ellipse cx="140" cy="195" rx="13" ry="10" fill="#5ABA48" stroke="#5ABA48" stroke-width="2" />
              <ellipse cx="132" cy="210" rx="11" ry="11" fill="#5ABA48" stroke="#5ABA48" stroke-width="2" />
              <ellipse cx="148" cy="210" rx="11" ry="11" fill="#5ABA48" stroke="#5ABA48" stroke-width="2" />
              <ellipse cx="140" cy="218" rx="12" ry="10" fill="#5ABA48" stroke="#5ABA48" stroke-width="2" />
              <ellipse cx="140" cy="172" rx="10" ry="8" fill="#5ABA48" stroke="#5ABA48" stroke-width="2" />
            </g>
            <g id="canopy-light">
              <ellipse cx="138" cy="173" rx="9" ry="7" fill="#8AE66A" stroke="#8AE66A" stroke-width="1.5" />
              <ellipse cx="152" cy="182" rx="9" ry="7" fill="#8AE66A" stroke="#8AE66A" stroke-width="1.5" />
              <ellipse cx="145" cy="188" rx="10" ry="8" fill="#8AE66A" stroke="#8AE66A" stroke-width="1.5" />
              <ellipse cx="135" cy="198" rx="8" ry="6" fill="#8AE66A" stroke="#8AE66A" stroke-width="1.5" />
              <ellipse cx="150" cy="205" rx="8" ry="6" fill="#8AE66A" stroke="#8AE66A" stroke-width="1.5" />
              <ellipse cx="140" cy="215" rx="9" ry="7" fill="#8AE66A" stroke="#8AE66A" stroke-width="1.5" />
            </g>
            <g id="canopy-highlights">
              <circle cx="140" cy="168" r="2.5" fill="#C8FA9A" />
              <circle cx="150" cy="176" r="2.5" fill="#C8FA9A" />
              <circle cx="145" cy="184" r="2.5" fill="#C8FA9A" />
              <circle cx="138" cy="193" r="2" fill="#C8FA9A" />
              <circle cx="148" cy="202" r="2" fill="#C8FA9A" />
            </g>
          </g>
        </svg>
      </div>
    </section>

    <!-- ═══ SOCIAL PROOF (Доверие) ═══ -->
    <section class="section" style="padding-top: 0; padding-bottom: 2rem;">
      <div style="text-align: center; color: var(--text-muted); font-size: 0.875rem;">
        <p>Уже растят свои привычки в RuStore</p>
        <div style="display: flex; justify-content: center; align-items: center; gap: 0.5rem; margin-top: 0.5rem; font-size: 1.125rem; font-weight: 700; color: var(--text);">
          <span style="color: var(--gold);">★★★★★</span>
          <span>4.8</span>
        </div>
      </div>
    </section>

    <!-- ═══ FEATURES ═══ -->
    <section id="features" class="section">
      <div class="section-header">
        <span class="section-eyebrow">Возможности</span>
        <h2 class="section-title">Всё, чтобы не бросить на второй день</h2>
        <p class="section-subtitle">
          Мы убрали всё лишнее и оставили только то, что реально помогает
          формировать привычки.
        </p>
      </div>

      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon">🌳</div>
          <h3 class="feature-title">Визуальная мотивация</h3>
          <p class="feature-description">
            Каждая выполненная привычка питает дерево. Смотрите, как оно растёт
            из семечка до цветущего сада.
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">📊</div>
          <h3 class="feature-title">Виджет и стрики</h3>
          <p class="feature-description">
            Держите прогресс на рабочем столе. Отслеживайте серии дней и не
            теряйте мотивацию.
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">📔</div>
          <h3 class="feature-title">Дневник настроения</h3>
          <p class="feature-description">
            Записывайте мысли и эмоции. Понимайте, что влияет на вашу
            продуктивность и состояние.
          </p>
        </div>
      </div>
    </section>

    <!-- ═══ HOW IT WORKS ═══ -->
    <section class="section">
      <div class="section-header">
        <span class="section-eyebrow">Как это работает</span>
        <h2 class="section-title">Три шага до первой привычки</h2>
        <p class="section-subtitle">Никаких сложных настроек. Начните прямо сейчас.</p>
      </div>

      <div class="steps-grid">
        <div class="step-card">
          <div class="step-content">
            <h3>Посадите семечко</h3>
            <p>Создайте первую привычку: читать, пить воду или делать зарядку.</p>
          </div>
        </div>
        <div class="step-card">
          <div class="step-content">
            <h3>Питайте дерево</h3>
            <p>Отмечайте выполнение каждый день. Смотрите, как растёт ваш сад.</p>
          </div>
        </div>
        <div class="step-card">
          <div class="step-content">
            <h3>Собирайте плоды</h3>
            <p>Достигайте целей и наблюдайте, как меняется ваша жизнь.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ FINAL CTA ═══ -->
    <section class="final-cta">
      <h2 class="section-title">Посадите своё первое семечко</h2>
      <p class="section-subtitle">
        Бесплатно. Без рекламы. Без встроенных покупок.
      </p>
      <a
        href="https://www.rustore.ru/catalog/app/com.owevyat.habitwood"
        class="btn btn-primary"
        target="_blank"
        rel="noopener"
      >
        Скачать в RuStore
      </a>

      <!-- QR-код для десктопа -->
      <div class="qr-code">
        <p>Наведите камеру телефона, чтобы скачать</p>
        <div style="width: 120px; height: 120px; background-color: #1A1A1A; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; color: var(--text-muted);">
          [QR-код]
        </div>
      </div>
    </section>

    <!-- ═══ FOOTER ═══ -->
    <footer class="footer">
      <p>
        © 2026 Дерево привычек.
        <a href="https://owevyat.github.io/habitwood/privacy.html">Политика конфиденциальности</a> ·
        <a href="https://owevyat.github.io/habitwood/terms.html">Условия использования</a>
      </p>
      <p style="margin-top: 0.5rem;">
        Есть вопросы? <a href="mailto:owevyat.support@gmail.com">owevyat.support@gmail.com</a>
      </p>
    </footer>
  </main>

  <!-- Скрипт для появления Sticky CTA -->
  <script>
    const stickyCta = document.getElementById('sticky-cta');
    const hero = document.querySelector('.hero');

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) {
            stickyCta.classList.add('is-visible');
            stickyCta.setAttribute('aria-hidden', 'false');
          } else {
            stickyCta.classList.remove('is-visible');
            stickyCta.setAttribute('aria-hidden', 'true');
          }
        });
      },
      { threshold: 0.1 }
    );

    if (hero) {
      observer.observe(hero);
    }
  </script>
</Layout>