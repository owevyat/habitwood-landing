                  </g>
                  <g id="canopy-light">
                    <ellipse cx="138" cy="173" rx="9" ry="7" fill="#8AE66A" stroke="#8AE66A" stroke-width="1.5" />
                    <ellipse cx="152" cy="182" rx="9" ry="7" fill="#8AE66A" stroke="#8AE66A" stroke-width="1.5" />
                    <ellipse cx="145" cy="188" rx="10" ry="8" fill="#8AE66A" stroke="#8AE66A" stroke-width="1.5" />
                    <ellipse cx="135" cy="198" rx="8" ry="6" fill="#8AE66A" stroke="#8AE66A" stroke-width="1.5" />
                    <ellipse cx="150" cy="205" rx="8" ry="6" fill="#8AE66A" stroke="#8AE66A" stroke-width="1.5" />
                    <ellipse cx="140" cy="215" rx="9" ry="7" fill="#8AE66A" stroke="#8AE66A" stroke-width="1.5" />
