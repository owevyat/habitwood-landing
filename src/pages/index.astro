                    <path d="M 158 308 Q 162 324 158 338" fill="none" stroke="#4A3420" stroke-width="2.5" stroke-linecap="round" />
                    <path d="M 112 306 Q 108 318 112 330" fill="none" stroke="#5A3E2A" stroke-width="2" stroke-linecap="round" />
                    <path d="M 172 304 Q 176 318 170 332" fill="none" stroke="#5A3E2A" stroke-width="2" stroke-linecap="round" />
                  </g>
                  <g id="island-fragments">
                    <ellipse cx="100" cy="348" rx="5" ry="3" fill="#4A3420" opacity="0.85" />
                    <ellipse cx="176" cy="344" rx="4" ry="2.5" fill="#4A3420" opacity="0.85" />
                    <circle cx="86" cy="340" r="2.5" fill="#4A3420" opacity="0.7" />
                    <circle cx="190" cy="336" r="2" fill="#4A3420" opacity="0.7" />
                  </g>
                  <g id="island-back">
                    <path d="M 76 264 C 76 254 106 248 140 248 C 174 248 204 254 204 264 L 204 282 C 200 290 186 296 172 295 L 172 302 C 178 308 176 314 170 316 L 170 320 C 172 324 168 328 160 328 C 154 332 146 330 140 330 C 134 330 126 332 120 328 C 112 328 108 324 110 320 L 110 316 C 104 314 102 308 108 302 L 108 295 C 94 296 80 290 76 282 Z" fill="#3A2A18" />
                  </g>
                  <g id="island-main">
                    <path d="M 100 300 C 100 294 118 290 140 290 C 162 290 180 294 180 300 L 180 310 C 174 314 162 316 152 315 C 146 317 144 316 140 316 C 136 316 134 317 128 315 C 118 316 106 314 100 310 Z" fill="#4A3420" />
                    <ellipse cx="140" cy="300" rx="38" ry="3" fill="#5A4538" />
                    <path d="M 88 282 C 88 276 112 272 140 272 C 168 272 192 276 192 282 L 192 294 C 186 299 174 302 162 301 C 152 304 146 303 140 303 C 134 303 128 304 118 301 C 106 302 94 299 88 294 Z" fill="#5A3E2A" />
                    <ellipse cx="140" cy="282" rx="50" ry="4" fill="#7AAE55" />
                    <path d="M 80 266 C 80 260 108 256 140 256 C 172 256 200 260 200 266 L 200 278 C 195 283 182 286 168 285 C 158 288 152 287 146 287 C 142 289 138 289 134 287 C 128 287 122 288 112 285 C 98 286 85 283 80 278 Z" fill="#6A4A32" />
                    <ellipse cx="140" cy="267" rx="52" ry="5" fill="#9EDB70" />
                  </g>
                  <g id="island-front">
                    <path d="M 100 284 Q 98 290 101 293 Q 103 289 102 284 Z" fill="#9EDB70" />
                    <path d="M 118 287 Q 117 293 119 296 Q 121 292 120 287 Z" fill="#9EDB70" />
                    <path d="M 160 287 Q 159 294 161 297 Q 163 292 162 287 Z" fill="#9EDB70" />
                    <path d="M 178 285 Q 177 291 179 294 Q 181 290 180 285 Z" fill="#9EDB70" />
                    <path d="M 108 297 Q 106 303 108 306 Q 110 302 110 297 Z" fill="#7AAE55" />
                    <path d="M 172 297 Q 170 303 172 306 Q 174 301 174 297 Z" fill="#7AAE55" />
                  </g>
                  <g id="island-details">
                    <ellipse cx="170" cy="268" rx="3" ry="1.5" fill="#3A2A1E" />
                    <circle cx="105" cy="269" r="1.5" fill="#3A2A1E" />
                    <circle cx="130" cy="271" r="1.2" fill="#3A2A1E" />
                    <circle cx="155" cy="270" r="1.3" fill="#3A2A1E" />
                    <circle cx="115" cy="288" r="1.5" fill="#3A2A1E" />
                    <circle cx="165" cy="290" r="1.3" fill="#3A2A1E" />
