  </main>

  <script>
    // Sticky CTA
    const stickyCta = document.getElementById('sticky-cta');
    const hero = document.querySelector('.hero');

    if (stickyCta && hero) {
      const ctaObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const visible = !entry.isIntersecting;
            stickyCta.classList.toggle('is-visible', visible);
            stickyCta.setAttribute('aria-hidden', String(!visible));
          });
        },
        { threshold: 0.05 }
      );
      ctaObserver.observe(hero);
    }

    // Reveal
    const revealEls = document.querySelectorAll('.reveal');
    if ('IntersectionObserver' in window) {
      const revealObserver = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              obs.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -48px 0px' }
      );
      revealEls.forEach((el) => revealObserver.observe(el));
    } else {
      revealEls.forEach((el) => el.classList.add('is-visible'));
    }

    // Блик за курсором на карточках
    const hasFinePointer = window.matchMedia('(pointer: fine)').matches;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (hasFinePointer && !reduceMotion) {
      const glowCards = document.querySelectorAll('[data-glow]');
      glowCards.forEach((card) => {
        card.addEventListener('pointermove', (e) => {
          const rect = card.getBoundingClientRect();
          card.style.setProperty('--mx', `${e.clientX - rect.left}px`);
          card.style.setProperty('--my', `${e.clientY - rect.top}px`);
        }, { passive: true });
      });
    }

    // Параллакс дерева на десктопе
    const treeFrame = document.getElementById('tree-frame');
    const treeStage = document.getElementById('tree-stage');

    if (hasFinePointer && !reduceMotion && treeFrame && treeStage) {
      let rafId = null;
      let targetX = 0;
      let targetY = 0;
      let currentX = 0;
      let currentY = 0;

      const animate = () => {
        currentX += (targetX - currentX) * 0.08;
        currentY += (targetY - currentY) * 0.08;
        treeFrame.style.transform = `translate3d(${currentX}px, ${currentY}px, 0)`;

        if (Math.abs(targetX - currentX) > 0.1 || Math.abs(targetY - currentY) > 0.1) {
          rafId = requestAnimationFrame(animate);
        } else {
          rafId = null;
        }
      };

      treeStage.addEventListener('pointermove', (e) => {
        const rect = treeStage.getBoundingClientRect();
        const cx = rect.left + rect.width / 2;
        const cy = rect.top + rect.height / 2;
        targetX = ((e.clientX - cx) / rect.width) * 24;
        targetY = ((e.clientY - cy) / rect.height) * 24;
        if (!rafId) rafId = requestAnimationFrame(animate);
      }, { passive: true });

      treeStage.addEventListener('pointerleave', () => {
        targetX = 0;
        targetY = 0;
        if (!rafId) rafId = requestAnimationFrame(animate);
      });
    }
  </script>

