---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Дерево привычек — Трекер и дневник">
  <main>
    <section class="hero">
      <div class="hero-content">
        <h1>Трекер привычек, дневник и виджет</h1>
        <p class="subtitle">
          Растите дерево, выполняя привычки. Визуальная мотивация, которая работает.
        </p>
        <div class="cta-group">
          <a href="https://www.rustore.ru/catalog/app/com.owevyat.habitwood" class="btn-primary" target="_blank" rel="noopener">
            Скачать в RuStore
          </a>
          <a href="#features" class="btn-secondary">Узнать больше</a>
        </div>
      </div>

      <div class="hero-visual">
        <!--
          СЮДА МЫ ВСТАВИМ SVG-КОД ТВОЕГО ДЕРЕВА (СТАДИЯ 5).
          Пока что здесь будет заглушка, чтобы было видно структуру.
        -->
        <div class="tree-placeholder">
          <p>🌳 Здесь будет твоё дерево (SVG)</p>
        </div>
      </div>
    </section>
  </main>
</Layout>